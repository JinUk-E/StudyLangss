<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>kr.haru.jlpt</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/node</string>
    <string>/ABSOLUTE/PATH/TO/StudyLangss/server.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/TO/StudyLangss</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOST</key><string>127.0.0.1</string>
    <key>PORT</key><string>3210</string>
  </dict>
  <key>StandardOutPath</key><string>/tmp/haru-jlpt.stdout.log</string>
  <key>StandardErrorPath</key><string>/tmp/haru-jlpt.stderr.log</string>
</dict>
</plist>
