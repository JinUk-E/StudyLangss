# Include this file INSIDE nginx.conf's http {} block, e.g. servers/haru.conf.
# Replace jlpt.example.com and both certificate paths before enabling.
# Password verification is performed by the app, including every /api route.
limit_req_zone $binary_remote_addr zone=haru_requests:10m rate=5r/s;

server {
    listen 80;
    server_name jlpt.example.com;

    location ^~ /.well-known/acme-challenge/ {
        root /opt/homebrew/var/www/haru-acme;
        default_type text/plain;
    }
    location / {
        return 301 https://jlpt.example.com$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name jlpt.example.com;

    ssl_certificate /opt/homebrew/etc/letsencrypt/live/jlpt.example.com/fullchain.pem;
    ssl_certificate_key /opt/homebrew/etc/letsencrypt/live/jlpt.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 32m;
    limit_req zone=haru_requests burst=20 nodelay;
    limit_req_status 429;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    location / {
        # Nginx on the same Mac: retain app's default loopback binding.
        # Nginx on a NAS/other machine: use the Mac LAN IP and restrict its firewall.
        proxy_pass http://127.0.0.1:3210;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_cache off;
    }
}
