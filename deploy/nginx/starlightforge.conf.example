# Starlight Forge: DNS-01 certificates; port 80 remains available for existing Certbot.
map_hash_bucket_size 64;
# Public UI files must not consume the API/login/document request budget.
# Keep a separate, bounded budget; do not exempt arbitrary *.js API paths.
map $uri $starlight_dynamic_key {
    default $binary_remote_addr;
    ~^/site/(?:styles\.css|editorial\.css|app\.js|shared\.js|resume\.js)$ "";
    ~^/shared/shell\.(?:css|js)$ "";
    ~^/pwa/(?:register\.js|app\.js|styles\.css|icon\.svg|icon-192\.png|icon-512\.png|apple-touch-icon\.png)$ "";
    /pwa/starlight-mark.png "";
    /sw.js "";
    /manifest.webmanifest "";
}
map $starlight_dynamic_key $starlight_asset_key {
    default "";
    "" $binary_remote_addr;
}
limit_req_zone $starlight_dynamic_key zone=starlight_dynamic:10m rate=5r/s;
limit_req_zone $starlight_asset_key zone=starlight_assets:10m rate=30r/s;

# Only Nginx-generated errors use these local files. App/API errors pass through.
map $http_accept $starlight_error_page {
    default /_errors/unavailable.json;
    ~*text/html /_errors/unavailable.html;
}

server {
    listen 443 ssl;
    server_name starlightforge.duckdns.org;
    server_tokens off;
    proxy_intercept_errors off;
    error_page 400 401 403 404 405 408 413 414 429 500 502 503 504 $starlight_error_page;

    ssl_certificate /ABSOLUTE/PATH/TO/StudyLangss/data/letsencrypt/config/live/starlightforge.duckdns.org/fullchain.pem;
    ssl_certificate_key /ABSOLUTE/PATH/TO/StudyLangss/data/letsencrypt/config/live/starlightforge.duckdns.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Stream large responses without relying on shared proxy_temp ownership.
    proxy_max_temp_file_size 0;

    client_max_body_size 32m;
    limit_req zone=starlight_dynamic burst=20 nodelay;
    limit_req zone=starlight_assets burst=100 nodelay;
    limit_req_status 429;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    # Read directly from disk even if every Node process is unavailable.
    # Replace /ABSOLUTE/PATH/TO/StudyLangss with the actual Mac checkout.
    location = /_errors/unavailable.html {
        internal;
        alias /ABSOLUTE/PATH/TO/StudyLangss/public/errors/unavailable.html;
        types { }
        default_type text/html;
        charset utf-8;
        add_header Cache-Control no-store always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;
    }
    location = /_errors/unavailable.json {
        internal;
        alias /ABSOLUTE/PATH/TO/StudyLangss/public/errors/unavailable.json;
        types { }
        default_type application/json;
        charset utf-8;
        add_header Cache-Control no-store always;
        add_header X-Content-Type-Options nosniff always;
    }

    # Personal chat: independent API and SQLite store; authentication in chat-server.mjs.
    location ~ ^/(chat(?:/|$)|api/chat/) {
        proxy_pass http://127.0.0.1:3211;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        client_max_body_size 64k;
        proxy_buffering off;
        proxy_cache off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location = /study { return 302 /study/; }

    location ^~ /api/portfolio/ {
        proxy_pass http://127.0.0.1:3212;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_cache off;
        client_max_body_size 8m;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3210;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        # Qwen request: total queue/generation 140s; browser wait 150s.
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_cache off;
    }

    location /study/ {
        proxy_pass http://127.0.0.1:3210/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_cache off;
    }

    location / {
        proxy_pass http://127.0.0.1:3212;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_cache off;
    }

}
